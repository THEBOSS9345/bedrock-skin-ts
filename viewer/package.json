{
  "name": "bedrock-skin-viewer",
  "version": "0.1.0",
  "description": "A drop-in 3D viewer for Minecraft Bedrock skins: drag to turn, scroll to zoom, animations, armor and held items. Works with any framework, or none, and has a React component.",
  "license": "Unlicense",
  "keywords": [
    "minecraft",
    "bedrock",
    "mcpe",
    "skin",
    "viewer",
    "3d",
    "web-component",
    "react",
    "custom-element",
    "animation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/THEBOSS9345/bedrock-skin-ts.git",
    "directory": "viewer"
  },
  "homepage": "https://github.com/THEBOSS9345/bedrock-skin-ts/tree/main/viewer#readme",
  "bugs": {
    "url": "https://github.com/THEBOSS9345/bedrock-skin-ts/issues"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./package.json": "./package.json",
    "./standalone": {
      "types": "./dist/index.d.ts",
      "default": "./dist/bedrock-skin-viewer.esm.min.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/element.js"
  ],
  "scripts": {
    "build": "tsup && node tools/use-client.mjs && node tools/bundle.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "bedrock-skin": "^0.1.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "unpkg": "./dist/bedrock-skin-viewer.min.js",
  "jsdelivr": "./dist/bedrock-skin-viewer.min.js"
}
