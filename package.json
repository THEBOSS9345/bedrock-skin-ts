{
  "name": "bedrock-skin",
  "version": "0.0.0",
  "private": true,
  "description": "Render Minecraft Bedrock skins: 3D models, capes, custom geometry, persona skins, Blockbench animations and invisible-skin detection. A TypeScript port of bedrock-skin-go, pixel for pixel.",
  "license": "Unlicense",
  "keywords": [
    "minecraft",
    "bedrock",
    "skin",
    "render",
    "mcpe"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/THEBOSS9345/bedrock-skin-ts.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run check:package",
    "check:package": "attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
